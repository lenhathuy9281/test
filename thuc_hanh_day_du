## 9.3 Screen (State Hoisting + collectAsStateWithLifecycle + Paging)

```kotlin
package com.example.feature.expense

import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import androidx.paging.compose.collectAsLazyPagingItems
import androidx.paging.compose.itemKey
import com.example.core.ui.AppButton
import com.example.core.ui.AppCard
import com.example.core.ui.AppText
import dagger.hilt.android.lifecycle.HiltViewModel
import androidx.hilt.navigation.compose.hiltViewModel

@Composable
fun ExpenseListRoute(
  onAdd: () -> Unit,
  onEdit: (Long) -> Unit,
  vm: ExpenseListViewModel = hiltViewModel()
) {
  val ui by vm.state.collectAsStateWithLifecycle()
  val lazyItems = vm.paging.collectAsLazyPagingItems()

  ExpenseListScreen(
    ui = ui,
    lazyItems = lazyItems,
    onAdd = onAdd,
    onEdit = onEdit
  )
}

/** State hoisting: screen nhận state + callbacks */
@Composable
private fun ExpenseListScreen(
  ui: ExpenseListUiState,
  lazyItems: androidx.paging.compose.LazyPagingItems<com.example.core.domain.expense.Expense>,
  onAdd: () -> Unit,
  onEdit: (Long) -> Unit
) {
  Column(Modifier.fillMaxSize().padding(16.dp)) {
    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
      AppText("Chi tiêu", style = MaterialTheme.typography.titleLarge)
      AppButton(text = "Thêm", onClick = onAdd)
    }

    Spacer(Modifier.height(12.dp))

    when {
      ui.error != null -> AppText("Lỗi: ${ui.error}")
      lazyItems.itemCount == 0 && lazyItems.loadState.refresh is androidx.paging.LoadState.NotLoading -> {
        AppText("Chưa có khoản chi nào")
      }
      else -> {
        androidx.compose.foundation.lazy.LazyColumn {
          items(
            count = lazyItems.itemCount,
            key = lazyItems.itemKey { it.id }
          ) { index ->
            val item = lazyItems[index] ?: return@items
            AppCard(
              modifier = Modifier
                .fillMaxWidth()
                .padding(vertical = 6.dp)
                .clickable { onEdit(item.id) }
            ) {
              Column(Modifier.padding(12.dp)) {
                AppText(item.title, style = MaterialTheme.typography.titleMedium)
                AppText("${item.amount} VND")
              }
            }
          }
        }
      }
    }
  }
}
