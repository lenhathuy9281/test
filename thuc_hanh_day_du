## 8.2 Worker ví dụ: đồng bộ cache từ API (PeriodicWork)

```kotlin
package com.example.core.work

import android.content.Context
import androidx.hilt.work.HiltWorker
import androidx.work.*
import com.example.core.domain.expense.RefreshExpenseUseCase
import dagger.assisted.Assisted
import dagger.assisted.AssistedInject

@HiltWorker
class ExpenseSyncWorker @AssistedInject constructor(
  @Assisted appContext: Context,
  @Assisted params: WorkerParameters,
  private val refresh: RefreshExpenseUseCase
) : CoroutineWorker(appContext, params) {

  override suspend fun doWork(): Result {
    return when (refresh.execute()) {
      is com.example.core.common.AppResult.Success -> Result.success()
      is com.example.core.common.AppResult.Error -> Result.retry()
    }
  }

  companion object {
    const val UNIQUE_NAME = "expense_sync"
  }
}

class SyncScheduler(private val wm: WorkManager) {
  fun scheduleExpenseSync() {
    val req = PeriodicWorkRequestBuilder<ExpenseSyncWorker>(12, java.util.concurrent.TimeUnit.HOURS)
      .setConstraints(
        Constraints.Builder()
          .setRequiredNetworkType(NetworkType.CONNECTED)
          .build()
      )
      .build()

    wm.enqueueUniquePeriodicWork(
      ExpenseSyncWorker.UNIQUE_NAME,
      ExistingPeriodicWorkPolicy.KEEP,
      req
    )
  }
}
```

> Subscription reminder worker sẽ tương tự, chỉ khác ở chỗ load subscription từ DB và show notification (bạn muốn mình triển khai tiếp phần Subscription đầy đủ theo phase sau).

