## 11.2 Hilt modules

```kotlin
package com.example.smartexpense.di

import android.content.Context
import androidx.room.Room
import androidx.work.WorkManager
import com.example.core.common.DefaultDispatcherProvider
import com.example.core.common.DispatcherProvider
import com.example.core.database.AppDatabase
import com.example.core.database.dao.ExpenseDao
import com.example.core.database.migration.MIGRATION_1_2
import com.example.core.domain.expense.ExpenseRepository
import com.example.core.domain.expense.RefreshExpenseUseCase
import com.example.core.domain.expense.UpsertExpenseUseCase
import com.example.core.network.ExpenseApi
import com.example.core.network.FakeExpenseApi
import com.example.core.data.expense.ExpenseRepositoryImpl
import dagger.Module
import dagger.Provides
import dagger.hilt.InstallIn
import dagger.hilt.android.qualifiers.ApplicationContext
import dagger.hilt.components.SingletonComponent
import javax.inject.Singleton

@Module
@InstallIn(SingletonComponent::class)
object AppModule {

  @Provides @Singleton
  fun provideDispatchers(): DispatcherProvider = DefaultDispatcherProvider()

  @Provides @Singleton
  fun provideDb(@ApplicationContext ctx: Context): AppDatabase =
    Room.databaseBuilder(ctx, AppDatabase::class.java, "smart_expense.db")
      .addMigrations(MIGRATION_1_2)
      .build()

  @Provides fun provideExpenseDao(db: AppDatabase): ExpenseDao = db.expenseDao()

  @Provides @Singleton
  fun provideExpenseApi(): ExpenseApi = FakeExpenseApi()

  @Provides @Singleton
  fun provideExpenseRepo(
    dao: ExpenseDao,
    api: ExpenseApi,
    dp: DispatcherProvider
  ): ExpenseRepository = ExpenseRepositoryImpl(dao, api, dp)

  @Provides fun provideUpsertExpense(repo: ExpenseRepository) = UpsertExpenseUseCase(repo)
  @Provides fun provideRefreshExpense(repo: ExpenseRepository) = RefreshExpenseUseCase(repo)

  @Provides @Singleton
  fun provideWorkManager(@ApplicationContext ctx: Context): WorkManager = WorkManager.getInstance(ctx)
}
