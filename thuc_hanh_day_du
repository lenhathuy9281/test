## 7.2 Mapper + RepositoryImpl (Offline-first + Refresh cache)

```kotlin
package com.example.core.data.expense

import androidx.paging.*
import com.example.core.common.AppResult
import com.example.core.database.dao.ExpenseDao
import com.example.core.database.entity.ExpenseEntity
import com.example.core.domain.expense.*
import com.example.core.network.ExpenseApi
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map
import kotlinx.coroutines.withContext
import javax.inject.Inject
import javax.inject.Singleton

private fun ExpenseEntity.toDomain() = Expense(
  id = expenseId,
  amount = amount,
  title = title,
  note = note,
  occurredAtEpochMs = occurredAtEpochMs
)

@Singleton
class ExpenseRepositoryImpl @Inject constructor(
  private val dao: ExpenseDao,
  private val api: ExpenseApi,
  private val dispatchers: com.example.core.common.DispatcherProvider
) : ExpenseRepository {

  override fun observePaging(): Flow<PagingData<Expense>> {
    return Pager(
      config = PagingConfig(pageSize = 20, prefetchDistance = 2, enablePlaceholders = false),
      pagingSourceFactory = { dao.pagingSource() }
    ).flow.map { paging -> paging.map { it.toDomain() } }
  }

  override suspend fun getById(id: Long): Expense? = withContext(dispatchers.io) {
    dao.getById(id)?.toDomain()
  }

  override suspend fun upsert(input: ExpenseUpsertInput): AppResult<Long> = withContext(dispatchers.io) {
    try {
      val entity = ExpenseEntity(
        expenseId = input.id ?: 0,
        amount = input.amount,
        title = input.title.trim(),
        note = input.note?.trim()?.takeIf { it.isNotBlank() },
        occurredAtEpochMs = input.occurredAtEpochMs
      )
      val id = if (input.id == null) dao.insert(entity) else {
        dao.update(entity); input.id
      }
      AppResult.Success(id!!)
    } catch (t: Throwable) {
      AppResult.Error("Upsert expense failed", t)
    }
  }

  override suspend fun delete(id: Long): AppResult<Unit> = withContext(dispatchers.io) {
    try {
      dao.deleteById(id)
      AppResult.Success(Unit)
    } catch (t: Throwable) {
      AppResult.Error("Delete expense failed", t)
    }
  }

  override suspend fun refreshFromRemote(): AppResult<Unit> = withContext(dispatchers.io) {
    try {
      val remote = api.fetchExpenses()
      val mapped = remote.map {
        ExpenseEntity(
          expenseId = 0, // cache into local; nếu muốn map theo remote id => thêm remoteId column
          amount = it.amount,
          title = it.title,
          note = it.note,
          occurredAtEpochMs = it.occurredAtEpochMs
        )
      }
      dao.upsertAll(mapped)
      AppResult.Success(Unit)
    } catch (t: Throwable) {
      AppResult.Error("Refresh from remote failed", t)
    }
  }
}
```

