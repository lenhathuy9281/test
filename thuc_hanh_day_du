package com.example.core.domain.expense

import kotlinx.coroutines.flow.Flow

data class Expense(
  val id: Long,
  val amount: Long,
  val title: String,
  val note: String?,
  val occurredAtEpochMs: Long
)

data class ExpenseUpsertInput(
  val id: Long? = null,
  val amount: Long,
  val title: String,
  val note: String?,
  val occurredAtEpochMs: Long
)

interface ExpenseRepository {
  fun observePaging(): Flow<androidx.paging.PagingData<Expense>>
  suspend fun getById(id: Long): Expense?
  suspend fun upsert(input: ExpenseUpsertInput): com.example.core.common.AppResult<Long>
  suspend fun delete(id: Long): com.example.core.common.AppResult<Unit>

  /** Cache strategy: pull from API then store to DB */
  suspend fun refreshFromRemote(): com.example.core.common.AppResult<Unit>
}

class UpsertExpenseUseCase(private val repo: ExpenseRepository) {
  suspend fun execute(input: ExpenseUpsertInput) = repo.upsert(input)
}

class RefreshExpenseUseCase(private val repo: ExpenseRepository) {
  suspend fun execute() = repo.refreshFromRemote()
}
