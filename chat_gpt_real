### Entities (skeleton, sẽ thay bằng schema BCNF “chốt” của bạn)

```kotlin
package com.example.core.database.entity

import androidx.room.Entity
import androidx.room.Index
import androidx.room.PrimaryKey

@Entity(
    tableName = "tags",
    indices = [Index(value = ["name"], unique = true)]
)
data class TagEntity(
    @PrimaryKey(autoGenerate = true) val tagId: Long = 0,
    val name: String
)

@Entity(tableName = "expenses")
data class ExpenseEntity(
    @PrimaryKey(autoGenerate = true) val expenseId: Long = 0,
    val amount: Long,
    val occurredAtEpochMs: Long,
    val note: String?
)

/**
 * CrossRef: KHÔNG cần id riêng -> PK (expenseId, tagId)
 */
@Entity(
    tableName = "expense_tag",
    primaryKeys = ["expenseId", "tagId"]
)
data class ExpenseTagCrossRef(
    val expenseId: Long,
    val tagId: Long
)
```

### DAO (Flow realtime)

```kotlin
package com.example.core.database.dao

import androidx.room.Dao
import androidx.room.Insert
import androidx.room.OnConflictStrategy
import androidx.room.Query
import com.example.core.database.entity.ExpenseEntity
import kotlinx.coroutines.flow.Flow

@Dao
interface ExpenseDao {

    @Query("SELECT * FROM expenses ORDER BY occurredAtEpochMs DESC")
    fun observeAll(): Flow<List<ExpenseEntity>>

    @Insert(onConflict = OnConflictStrategy.ABORT)
    suspend fun insert(expense: ExpenseEntity): Long

    @Query("DELETE FROM expenses WHERE expenseId = :id")
    suspend fun deleteById(id: Long)
}
```

